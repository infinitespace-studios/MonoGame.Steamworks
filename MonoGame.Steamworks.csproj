<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Microsoft.Xna.Framework.Net</RootNamespace>
    <AssemblyName>MonoGame.Steamworks</AssemblyName>
    <DefineConstants>TRACE;STEAMWORKS_LIN_OSX</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <!-- <ProjectReference Include="Steamworks.NET\Standalone\Steamworks.NET.Standard.csproj">
      <Name>Steamworks.NET</Name>
    </ProjectReference> -->
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Remove="src\Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
